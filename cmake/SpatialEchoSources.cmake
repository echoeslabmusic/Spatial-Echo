    set_source_files_properties(${SPATIAL_ECHO_VENDORED_SOURCES} PROPERTIES COMPILE_OPTIONS "/w")
else()
    set_source_files_properties(${SPATIAL_ECHO_VENDORED_SOURCES} PROPERTIES COMPILE_OPTIONS "-w")
endif()
